# From @BotFather after creating your bot
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Your numeric Telegram user id (only these users can use the bot)
# Tip: message @userinfobot or @getidsbot
TELEGRAM_USER_ID=123456789

# Optional: comma-separated list for a small team
# TELEGRAM_USER_ID=111,222,333

# SQLite path (default in Docker: /data/bot.db via compose)
# SQLITE_PATH=./data/bot.db

# Default IANA zone when a user has no primary yet
# DEFAULT_TIMEZONE=UTC
